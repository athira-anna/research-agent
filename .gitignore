# --- Secrets: never commit keys. Only the template is tracked. ---------------------------------------
.env
.env.*
!.env.example

# --- Generated by runs ---------------------------------------------------------------------------------
# runs/ is tracked on purpose: each run folder is the agent's output (claims, analysis, brief.html).
# fetch cache (raw pages, keyed by URL hash)
cache/
# adk web sessions and artifacts (session.db)
.adk/

# --- Python --------------------------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tests and tools -----------------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editors and OS ------------------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# --- Claude Code: personal settings only (shared hooks, skills and settings.json are tracked) ----------
.claude/settings.local.json

