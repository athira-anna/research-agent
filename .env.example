# Copy to .env.local and fill in. .env.local is git-ignored; never commit real keys.
# Values already set in your shell take precedence over this file.

# --- LLM (Gemini) -------------------------------------------------------------
# Required from stage 2 on. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Fast, cheap model for stage 2's relevance / page-type check.
BRIEF_TRIAGE_MODEL=gemini-flash-lite-latest
# Stage 3 claim extraction (one call per source), and models tried if it's unavailable.
BRIEF_EXTRACT_MODEL=gemini-flash-latest
BRIEF_EXTRACT_FALLBACK_MODELS=gemini-flash-lite-latest
# Stage 3 support check (does the quote support the claim?): a separate, cheaper model.
BRIEF_SUPPORT_MODEL=gemini-flash-lite-latest
# Stages 4-5 (align claims across sources, judge agreement): strongest available model first.
BRIEF_REASON_MODEL=gemini-pro-latest
BRIEF_REASON_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# Stronger model for stage 0's research plan (one call per run; shapes every later stage).
BRIEF_PLANNER_MODEL=gemini-pro-latest
# Tried in order if the planner model is unavailable (free-tier keys have no Pro quota).
BRIEF_PLANNER_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Fetching (stage 1) -------------------------------------------------------
# User-Agent for plain HTTP requests. Some sites (e.g. Wikipedia) require a contact URL or email in it.
BRIEF_AGENT_UA=BriefAgent/0.1 (multi-source research brief tool; +https://github.com/)
# Optional: higher rate limits for the reader-service fallback (r.jina.ai). Works without it.
JINA_API_KEY=

# Local viewer that opens the finished brief in a browser tab (adk web / adk run).
BRIEF_VIEW_PORT=8766
